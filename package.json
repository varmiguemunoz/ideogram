{
  "name": "congen",
  "version": "1.0.0",
  "private": true,
  "description": "Content generation desktop app. Three independent layers: electron (window + native OS features), ui (React + Tailwind), api (Express, owns all Replicate and blob logic).",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "api",
    "ui",
    "electron"
  ],
  "scripts": {
    "dev": "run-p --print-label dev:api dev:ui dev:electron",
    "dev:api": "npm run dev -w congen-api",
    "dev:ui": "npm run dev -w congen-ui",
    "dev:electron": "npm run dev:wait -w congen-electron",
    "build": "run-s build:api build:api-bundle build:ui build:electron",
    "build:api": "npm run build -w congen-api",
    "build:api-bundle": "npm run build:bundle -w congen-api",
    "build:ui": "npm run build -w congen-ui",
    "build:electron": "npm run package -w congen-electron",
    "typecheck": "run-s typecheck:*",
    "typecheck:api": "npm run typecheck -w congen-api",
    "typecheck:ui": "npm run typecheck -w congen-ui",
    "typecheck:electron": "npm run typecheck -w congen-electron",
    "lint": "run-s lint:*",
    "lint:api": "npm run lint -w congen-api",
    "lint:ui": "npm run lint -w congen-ui",
    "lint:electron": "npm run lint -w congen-electron",
    "test": "npm run test -w congen-api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
