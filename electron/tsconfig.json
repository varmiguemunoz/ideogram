{
  "compilerOptions": {
    "target": "ES2022",
    // Vite does the actual bundling; tsc only type checks here, so the module
    // settings describe the bundler's view rather than an emit target.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "forge.config.ts",
    "forge.env.d.ts",
    "vite.main.config.ts",
    "vite.preload.config.ts"
  ]
}
